{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"

  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_HERE",
    "Issuer": "PatientTracker.API",
    "Audience": "PatientTracker.Client",
    "AccessTokenExpiration": 15,
    "RefreshTokenExpiration": 7
  },
  "AllowedHosts": "*",
  "Uploads": {
    "Path": "uploads",
    "MaxFileSize": 52428800,
    "MaxImageFileSize": 10485760,
    "MaxDocumentFileSize": 10485760,
    "ImageQuality": 80,
    "LabTestDocumentsPath": "uploads/lab-tests"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE"
  },
  "LabTestExtraction": {
    "MaxFileSize": 10485760
  },
  "Tesseract": {
    "TessDataPath": "./tessdata",
    "Language": "eng"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "YOUR_SMTP_USERNAME_HERE",
    "SmtpPassword": "YOUR_SMTP_PASSWORD_HERE",
    "FromEmail": "YOUR_FROM_EMAIL_HERE",
    "FromName": "Patient Tracker"
  },
  "App": {
    "BaseUrl": "http://sehty.org"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.MSSqlServer"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/patienttracker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "YOUR_CONNECTION_STRING_HERE",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ]
  }
}
